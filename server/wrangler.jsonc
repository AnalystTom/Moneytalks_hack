{
  "name": "council",
  "main": "worker.py",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "COUNCIL", "class_name": "Council" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Council"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "council", "database_id": "d330dcca-dbdb-4590-9b1b-e4630f0a2567" }],
  "find_additional_modules": true,
  "preserve_file_names": true,
  "rules": [{ "type": "Text", "globs": ["agents/personas/*.md", "agents/orchestrator.md", "agents/skill.md", "data/specialist.csv"], "fallthrough": true }]
}
