{
  "name": "moneytalks-hack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup:check": "tsx --env-file-if-exists=.env src/index.ts check",
    "smoke": "tsx --env-file-if-exists=.env src/index.ts run",
    "prism:verify": "tsx --env-file-if-exists=.env src/index.ts verify",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
